# つくちゃれ部ロボットのシリアル機器（2026-11-06）。by-id と同じくシリアル番号で 1 台ずつ指定する。
# ModemManager に触らせない（挿した直後の ttyACM に AT コマンドを送られないように）。

# RP2350-CAN（DDT モーターの CAN ブリッジ）
SUBSYSTEM=="tty", ENV{ID_VENDOR_ID}=="2e8a", ENV{ID_MODEL_ID}=="0009", ENV{ID_SERIAL_SHORT}=="3ABDAE89A4AE9010", ENV{ID_USB_INTERFACE_NUM}=="00", SYMLINK+="ddt_board", GROUP="dialout", MODE="0660", ENV{ID_MM_DEVICE_IGNORE}="1"

# DATAGNSS MA-10P（CH342）: if00 が NMEA（Serial-A、230400 bps）、if02 は受信機内 ESP32 の情報
SUBSYSTEM=="tty", ENV{ID_VENDOR_ID}=="1a86", ENV{ID_MODEL_ID}=="55d2", ENV{ID_SERIAL_SHORT}=="5AEC048232", ENV{ID_USB_INTERFACE_NUM}=="00", SYMLINK+="ma10p_nmea", GROUP="dialout", MODE="0660", ENV{ID_MM_DEVICE_IGNORE}="1"
SUBSYSTEM=="tty", ENV{ID_VENDOR_ID}=="1a86", ENV{ID_MODEL_ID}=="55d2", ENV{ID_SERIAL_SHORT}=="5AEC048232", ENV{ID_USB_INTERFACE_NUM}=="02", SYMLINK+="ma10p_info", GROUP="dialout", MODE="0660", ENV{ID_MM_DEVICE_IGNORE}="1"
